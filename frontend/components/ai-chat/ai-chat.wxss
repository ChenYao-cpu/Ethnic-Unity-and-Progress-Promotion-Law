.chat-scroll {
  height: 100%;
  padding: 20rpx;
}

.message-item {
  margin-bottom: 24rpx;
}

.message-bubble {
  max-width: 75%;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.user {
  background: linear-gradient(135deg, #DC143C, #FF6347);
  margin-left: auto;
  border-bottom-right-radius: 4rpx;
}

.user .bubble-text {
  color: #FFF;
}

.ai {
  background: #FFF;
  border: 2rpx solid #DAA520;
  border-bottom-left-radius: 4rpx;
}

.ai .bubble-text {
  color: #333;
  line-height: 1.6;
}

.bubble-text {
  font-size: 28rpx;
}

.typing-indicator {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background: #999;
  border-radius: 50%;
  margin: 0 8rpx;
  animation: bounce 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-20rpx); }
}
