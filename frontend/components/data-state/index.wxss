:host{display:block}.state-skeleton{padding:18rpx 0}.skeleton-row{display:flex;gap:22rpx;padding:26rpx 20rpx;margin-bottom:18rpx;background:#fffdf9;border-radius:18rpx}.skeleton-block{background:#e6e5e3;border-radius:10rpx;animation:state-pulse 1.4s ease-in-out infinite}.skeleton-thumb{width:105rpx;height:105rpx;flex-shrink:0}.skeleton-lines{flex:1;padding:8rpx 0}.skeleton-title{width:65%;height:25rpx;margin-bottom:20rpx}.skeleton-line{width:95%;height:18rpx;margin-bottom:15rpx}.skeleton-short{width:43%;height:18rpx}.state-message{display:flex;flex-direction:column;align-items:center;text-align:center;padding:45rpx 24rpx;gap:14rpx}.state-art{width:180rpx;height:150rpx}.state-title{font-size:28rpx;color:#59443e;line-height:1.5}.state-hint{font-size:24rpx;color:#897670;line-height:1.8;max-width:500rpx;word-break:break-all}.state-action{margin:14rpx 0 0;background:#791817;color:#fff8eb;font-size:25rpx;border-radius:40rpx;padding:0 36rpx;line-height:2.7}.state-action::after{border:0}@keyframes state-pulse{50%{opacity:.45}}@media(prefers-reduced-motion:reduce){.skeleton-block{animation:none}}
