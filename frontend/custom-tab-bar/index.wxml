<view class="tab-bar">
  <view class="tab-bar-item {{selected === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0" data-path="/pages/index/index">
    <image class="tab-icon" src="/images/tabbar/home{{selected === 0 ? '-active' : ''}}.png" mode="aspectFit"></image>
    <view class="tab-text">首页</view>
  </view>
  <view class="tab-bar-item {{selected === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1" data-path="/pages/study/study">
    <image class="tab-icon" src="/images/tabbar/study{{selected === 1 ? '-active' : ''}}.png" mode="aspectFit"></image>
    <view class="tab-text">学习</view>
  </view>
  <view class="tab-bar-item {{selected === 2 ? 'active' : ''}}" bindtap="switchTab" data-index="2" data-path="/pages/user/user">
    <image class="tab-icon" src="/images/tabbar/user{{selected === 2 ? '-active' : ''}}.png" mode="aspectFit"></image>
    <view class="tab-text">我的</view>
  </view>
</view>
