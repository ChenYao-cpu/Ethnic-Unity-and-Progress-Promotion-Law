@import '../../styles/iconfont.wxss';

page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 导航栏 */
.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  z-index: 101;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  line-height: 1;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.score-label-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.score-label-vertical text {
  font-size: 22rpx;
  color: #FFD700;
  font-weight: 500;
  line-height: 1;
}

.score-value {
  font-size: 40rpx;
  color: #FFD700;
  font-weight: bold;
  font-family: "Arial", sans-serif;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front, .logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front { background: #FFF; }
.logo-image { width: 90%; height: 90%; }

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
}

.school-name, .school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 160rpx 20rpx 100rpx;
}

/* 勋章进度条 */
.medal-progress {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.progress-text {
  font-size: 28rpx;
  color: #ED1C24;
  font-weight: bold;
}

/* 成就网格 - 两列布局 */
.achievements-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 成就卡片 */
.achievement-card {
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  min-height: 320rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

/* 已解锁 - 红色到粉色渐变 */
.achievement-card.unlocked {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8E9E 30%, #FFB4C8 60%, #FFD4E8 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

/* 未解锁 - 灰色 */
.achievement-card.locked {
  background: linear-gradient(135deg, #D5C4D8 0%, #C8B5CC 50%, #BFA6C4 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  opacity: 0.8;
}

/* 右上角状态标签 */
.status-badge {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.status-badge.unlocked {
  background: rgba(255, 255, 255, 0.85);
  color: #10B981;
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.2);
}

.status-badge.locked {
  background: rgba(255, 255, 255, 0.5);
  color: #999;
}

/* 勋章圆形区域 */
.medal-circle {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 20rpx 0 25rpx;
}

.medal-icon {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 165, 0, 0.4);
}

.medal-icon .iconfont {
  font-size: 60rpx;
  color: #FFF;
}

/* 已解锁的徽章发光效果 */
.achievement-card.unlocked .medal-icon {
  background: linear-gradient(135deg, #FFD700 0%, #FFC107 30%, #FFB300 60%, #FFA000 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 193, 7, 0.5), 0 0 40rpx rgba(255, 215, 0, 0.3);
}

/* 未解锁的灰色徽章 */
.achievement-card.locked .medal-icon {
  background: linear-gradient(135deg, #A0A0A0 0%, #808080 50%, #606060 100%);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

/* 锁遮罩 */
.lock-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lock-overlay .iconfont {
  font-size: 48rpx;
  color: #FFF;
}

/* 成就信息 */
.medal-info {
  text-align: center;
  width: 100%;
}

.medal-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #FFF;
  display: block;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.medal-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
  display: block;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.unlock-time {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

/* 未解锁文字样式 */
.achievement-card.locked .medal-name,
.achievement-card.locked .medal-desc,
.achievement-card.locked .unlock-time {
  color: rgba(255, 255, 255, 0.6);
}

/* 加载和空状态 */
.loading {
  text-align: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
