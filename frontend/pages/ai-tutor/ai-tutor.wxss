@import '../../styles/yunjiang/icons.wxss';
page{background:#FAF7EB;color:#302523}.tutor-page{padding:36rpx}.tutor-heading{display:flex;gap:16rpx;align-items:center;font-size:40rpx;color:#791817;font-weight:600;margin:20rpx 0}.tutor-intro{display:block;color:#796762;font-size:25rpx;line-height:1.9}.tutor-card{margin-top:28rpx;padding:30rpx;background:#fffdf8;border:1rpx solid #F0D3CC;border-radius:24rpx}.field-label,.section-label{display:block;margin:22rpx 0 16rpx;color:#791817;font-size:28rpx}.section-label{font-weight:600}input,textarea{background:#faf3eb;border:1rpx solid #ecd4cc;border-radius:12rpx;padding:20rpx;font-size:28rpx;box-sizing:border-box;width:100%}textarea{height:220rpx}button{margin-top:30rpx;background:#791817;color:#fff;font-size:28rpx}.paragraph{display:block;font-size:28rpx;line-height:1.9;white-space:pre-wrap}.quote{display:block;background:#F0D3CC55;border-left:5rpx solid #D07367;padding:22rpx;font-size:28rpx;line-height:1.9;margin-bottom:20rpx}.tutor-error{color:#791817;background:#f0d3cc;padding:24rpx;margin-top:24rpx;border-radius:12rpx;font-size:27rpx}

.tutor-avatar{width:64rpx;height:64rpx;border-radius:50%;flex-shrink:0;border:2rpx solid rgba(121,24,23,.18);}
