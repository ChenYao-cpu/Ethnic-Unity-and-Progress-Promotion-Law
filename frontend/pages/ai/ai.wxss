@import '../../styles/iconfont.wxss';

page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  z-index: 101;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  line-height: 1;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.score-label-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.score-label-vertical text {
  font-size: 22rpx;
  color: #FFD700;
  font-weight: 500;
  line-height: 1;
}

.score-value {
  font-size: 40rpx;
  color: #FFD700;
  font-weight: bold;
  font-family: "Arial", sans-serif;
}

.divider {
  width: 2rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 1rpx;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
  justify-content: center;
  align-items: center;
}

.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding-top: 160rpx;
  padding-bottom: 20rpx;
}

.intro-section {
  background: rgba(255, 255, 255, 0.92);
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.features {
  display: flex;
  justify-content: space-around;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  font-size: 50rpx;
  color: #ED1C24;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(237, 28, 36, 0.1);
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.feature-icon-large {
  width: 100rpx;
  height: 100rpx;
  font-size: 70rpx;
}

.feature-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.chat-area {
  height: calc(100vh - 500rpx);
  padding: 20rpx;
}

.welcome-message {
  padding: 20rpx 0;
}

.message-wrapper {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.ai-msg {
  flex-direction: row;
}

.user-msg {
  flex-direction: row-reverse;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 40rpx;
}

.ai-avatar {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF;
}

.user-avatar {
  background: #E0E0E0;
}

.message-text {
  max-width: 500rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.ai-msg .message-text {
  background: rgba(255, 255, 255, 0.92);
  color: #333;
}

.user-msg .message-text {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  font-size: 40rpx;
  color: #ED1C24;
  animation: dotBlink 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotBlink {
  0%, 60%, 100% { opacity: 0.3; }
  30% { opacity: 1; }
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

.input-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  padding: 20rpx;
  z-index: 100;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  background: rgba(237, 28, 36, 0.1);
  border-radius: 30rpx;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  color: #666;
}

.action-btn.active {
  background: rgba(237, 28, 36, 0.2);
  border-color: #ED1C24;
  color: #ED1C24;
  font-weight: 500;
}

.action-icon {
  font-size: 32rpx;
}

.input-area {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.input-box {
  flex: 1;
  height: 70rpx;
  padding: 0 24rpx;
  background: #F5F5F5;
  border-radius: 35rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 70rpx;
  line-height: 70rpx;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF;
  border-radius: 35rpx;
  font-size: 28rpx;
  border: none;
  padding: 0;
}

.send-btn[disabled] {
  background: #E0E0E0;
  color: #999;
}

.ai-avatar{overflow:hidden;background:transparent;}
.ai-avatar image{width:100%;height:100%;display:block;}
