page { background: #F5F5F5; min-height: 100vh; }
.page { min-height: 100vh; position: relative; overflow: hidden; }
.page-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }

.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%; height: 140rpx; display: flex; align-items: center;
  justify-content: space-between; padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box; position: fixed; top: 0; left: 0; right: 0; z-index: 100;
}

.nav-left { display: flex; align-items: center; z-index: 101; }
.nav-back { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 48rpx; color: #FFF; font-weight: bold; line-height: 1; }

.nav-title { display: flex; align-items: baseline; gap: 8rpx; }
.title-main { font-family: "MaoFont", "STXingkai", "KaiTi", serif; font-size: 60rpx; color: #FFF; font-weight: bold; }
.title-sub { font-size: 30rpx; color: #FFF; font-weight: bold; letter-spacing: 4rpx; }

.nav-right { display: flex; align-items: center; gap: 20rpx; }
.logo-flip-container { width: 80rpx; height: 80rpx; perspective: 1000rpx; }
.logo-card { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; }
.flip-animation { animation: logoFlip 4s ease-in-out infinite; }
@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}
.logo-front, .logo-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.logo-front { background: #FFF; border-radius: 50%; overflow: hidden; }
.logo-image { width: 90%; height: 90%; }
.logo-back { background: linear-gradient(135deg, #F03038, #ED1C24); transform: rotateY(180deg); flex-direction: column; border: 2rpx solid #FFF; }
.school-name { font-family: "MaoFont", "STXingkai", "KaiTi", serif; font-size: 18rpx; color: #FFF; font-weight: bold; }
.school-name-university { font-family: "MaoFont", "STXingkai", "KaiTi", serif; font-size: 18rpx; color: #FFF; font-weight: bold; margin-top: 2rpx; }

.container { position: relative; z-index: 1; min-height: 100vh; padding: 170rpx 30rpx 30rpx; box-sizing: border-box; }

.form-section { background: rgba(255,255,255,0.95); border-radius: 20rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 12rpx rgba(237,28,36,0.1); }
.form-item { margin-bottom: 24rpx; }
.label { font-size: 28rpx; color: #333; font-weight: 600; margin-bottom: 12rpx; display: block; }
.input { background: #f5f5f5; height: 80rpx; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; }
.textarea { background: #f5f5f5; min-height: 120rpx; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
.form-picker { background: #f5f5f5; height: 80rpx; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; display: flex; align-items: center; color: #333; }
.form-picker.placeholder { color: #999; }

.questions-section { background: rgba(255,255,255,0.95); border-radius: 20rpx; padding: 30rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 12rpx rgba(237,28,36,0.1); }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #2d3748; }
.header-actions { display: flex; gap: 16rpx; }
.add-btn { font-size: 24rpx; color: #718096; padding: 8rpx 16rpx; background: #f5f5f5; border-radius: 8rpx; }
.add-btn.primary { color: #ED1C24; background: #fff5f5; }

.question-card { background: #fafafa; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; border: 1rpx solid #eee; }
.question-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.question-num { font-size: 26rpx; font-weight: bold; color: #ED1C24; }
.question-tags { display: flex; gap: 8rpx; }
.q-tag { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.q-tag.single { background: #e6f7ff; color: #1890ff; }
.q-tag.multi { background: #fff7e6; color: #fa8c16; }
.q-tag.diff { background: #f6ffed; color: #52c41a; }
.question-text { font-size: 28rpx; color: #333; line-height: 1.6; display: block; margin-bottom: 12rpx; }
.question-options { display: flex; flex-direction: column; gap: 6rpx; margin-bottom: 12rpx; }
.opt { font-size: 24rpx; color: #666; }
.answer-text { font-size: 24rpx; color: #ED1C24; font-weight: 600; display: block; margin-bottom: 16rpx; }
.question-actions { display: flex; gap: 16rpx; justify-content: flex-end; }
.q-btn { font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 8rpx; border: none; line-height: 1.4; }
.q-btn.edit { background: #fff5f5; color: #ED1C24; border: 1rpx solid #ED1C24; }
.q-btn.delete { background: #fff; color: #999; border: 1rpx solid #ddd; }

.add-panel-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 200; display: flex; align-items: flex-end; }
.add-panel { background: #fff; width: 100%; max-height: 80vh; border-radius: 30rpx 30rpx 0 0; padding: 30rpx; overflow-y: auto; }
.panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.panel-title { font-size: 32rpx; font-weight: bold; color: #333; }
.panel-close { font-size: 36rpx; color: #999; padding: 10rpx; }

.config-item { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.config-label { font-size: 26rpx; color: #666; }
.picker { background: #f5f5f5; padding: 12rpx 24rpx; border-radius: 8rpx; font-size: 26rpx; color: #333; }
.config-input { background: #f5f5f5; width: 120rpx; padding: 12rpx 16rpx; border-radius: 8rpx; font-size: 26rpx; text-align: center; }

.bank-btn { background: #ED1C24; color: #fff; font-size: 28rpx; border-radius: 12rpx; margin-bottom: 24rpx; }
.pending-list { margin-bottom: 20rpx; }
.pending-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx; border-radius: 12rpx; margin-bottom: 12rpx; background: #fafafa; }
.pending-item.selected { background: #fff5f5; border: 1rpx solid #ED1C24; }
.checkbox { width: 40rpx; height: 40rpx; border: 2rpx solid #ddd; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.checkbox.checked { background: #ED1C24; border-color: #ED1C24; color: #fff; font-size: 24rpx; }
.pending-info { flex: 1; overflow: hidden; }
.pending-text { font-size: 26rpx; color: #333; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pending-type { font-size: 22rpx; color: #999; }
.confirm-btn { background: #ED1C24; color: #fff; font-size: 28rpx; border-radius: 12rpx; }

.save-btn { background: linear-gradient(135deg, #F03038, #ED1C24); color: #fff; font-size: 34rpx; font-weight: bold; border-radius: 16rpx; height: 90rpx; line-height: 90rpx; margin-top: 20rpx; margin-bottom: 40rpx; box-shadow: 0 8rpx 24rpx rgba(237,28,36,0.3); }

.empty-state { text-align: center; padding: 60rpx 0; }
.empty-text { font-size: 28rpx; color: #a0aec0; }
