@import '../../styles/iconfont.wxss';

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: #F5F5F5;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  z-index: 101;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  line-height: 1;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  width: 80rpx;
}

/* Tab 切换栏 */
.tabs {
  display: flex;
  background: white;
  padding: 20rpx 0;
  position: relative;
  z-index: 1;
  margin-top: 140rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ED1C24;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #ED1C24;
  border-radius: 3rpx;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 20rpx;
  min-height: calc(100vh - 200rpx);
}

/* 作业列表 */
.assignment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.assignment-card {
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.card-title-area {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.status-badge {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.pending {
  background: #FFF7E6;
  color: #FAAD14;
}

.status-badge.completed {
  background: #F6FFED;
  color: #52C41A;
}

.card-body {
  padding: 30rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
}

.info-item {
  flex: 1;
  min-width: 120rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
}

.info-value {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.info-value.highlight {
  color: #ED1C24;
  font-weight: bold;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background: #FAFAFA;
  border-top: 1rpx solid #F0F0F0;
}

.deadline-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.deadline-label {
  font-size: 24rpx;
  color: #999;
}

.deadline-value {
  font-size: 24rpx;
  color: #666;
}

.start-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.arrow {
  font-size: 36rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}