page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 导航栏样式 */
.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  z-index: 101;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  line-height: 1;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
  justify-content: center;
  align-items: center;
}

.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

.container {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 170rpx 30rpx 160rpx;
  box-sizing: border-box;
  background: transparent;
}

.filter-tabs {
    display: flex;
    gap: 16rpx;
    margin-bottom: 30rpx;
    background: rgba(255, 255, 255, 0.95);
    padding: 16rpx;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.1);
}

.tab {
    flex: 1;
    height: 64rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    color: #718096;
    border-radius: 32rpx;
    transition: all 0.3s;
}

.tab.active {
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
    color: #fff;
    font-weight: bold;
    box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.3);
}
.tab-dot {
  display: inline-block; background: #FFF; color: #DC2626;
  min-width: 32rpx; height: 32rpx; line-height: 32rpx;
  text-align: center; border-radius: 16rpx;
  font-size: 20rpx; font-weight: bold; margin-left: 6rpx; padding: 0 6rpx;
}

.assignment-list {
    display: flex;
    flex-direction: column;
    gap: 24rpx;
}

.assignment-card {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20rpx;
    padding: 30rpx;
    box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.1);
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.assignment-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #2d3748;
    flex: 1;
}

.status-badge {
    padding: 8rpx 20rpx;
    border-radius: 20rpx;
    font-size: 22rpx;
    font-weight: 500;
}

.status-badge.active {
    background: #e8f5e9;
    color: #4caf50;
}

.status-badge.expired {
    background: #ffebee;
    color: #f44336;
}

/* 审核状态标签 */
.status-badge.draft {
    background: #f0f0f0;
    color: #999;
}

.status-badge.pending_review {
    background: #fff7e6;
    color: #fa8c16;
}

.status-badge.approved {
    background: #e6f7ff;
    color: #1890ff;
}

.status-badge.published {
    background: #f6ffed;
    color: #52c41a;
}

/* 扩展状态标签 - 处理item.status为数字的情况 */
.status-badge[class*="0"] { background: #f0f0f0; color: #999; }
.status-badge[class*="1"] { background: #f6ffed; color: #52c41a; }

.card-info {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
    margin-bottom: 24rpx;
}

.info-item {
    font-size: 26rpx;
    color: #718096;
}

.card-actions {
    display: flex;
    gap: 16rpx;
}

.action-btn {
    flex: 1;
    height: 64rpx;
    border-radius: 32rpx;
    font-size: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f7fafc;
    color: #718096;
    border: none;
}

.action-btn.primary {
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
    color: #fff;
}

.action-btn.danger {
    color: #F03038;
    background: #fff5f5;
}

.action-btn.publish {
    background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
    color: #fff;
}

.action-btn.disabled {
    background: #f5f5f5;
    color: #bbb;
}

/* 新样式：状态行和截止标签 */
.status-row {
    display: flex;
    gap: 8rpx;
    align-items: center;
}

.deadline-badge {
    padding: 4rpx 12rpx;
    border-radius: 20rpx;
    font-size: 20rpx;
    font-weight: bold;
}
.deadline-badge.active { background: #e8f5e9; color: #4caf50; }
.deadline-badge.expired { background: #ffebee; color: #f44336; }

.status-badge.rejected {
    background: #fff2f0;
    color: #ff4d4f;
}

/* 驳回信息 */
.reject-info {
    background: #fff2f0;
    border: 1rpx solid #ffccc7;
    border-radius: 12rpx;
    padding: 16rpx;
    margin-bottom: 16rpx;
}
.reject-icon { font-size: 24rpx; }
.reject-text {
    font-size: 24rpx;
    color: #cf1322;
    margin-left: 8rpx;
}
.review-comment {
    display: block;
    font-size: 22rpx;
    color: #ff4d4f;
    margin-top: 8rpx;
    font-style: italic;
}

.waiting-badge {
    flex: 1;
    font-size: 24rpx;
    color: #fa8c16;
    padding: 8rpx 0;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 0;
}

.empty-icon {
    font-size: 100rpx;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #a0aec0;
}

.fab-btn {
    position: fixed;
    bottom: 60rpx;
    right: 40rpx;
    width: 100rpx;
    height: 100rpx;
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 56rpx;
    box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.4);
    z-index: 101;
}

.fab-btn:active { transform: scale(0.9); }

/* 审核通过意见框 */
.approved-info {
  background: #FEFCE8; border: 1rpx solid #FDE68A;
  border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx;
}
.approved-text { font-size: 24rpx; color: #854D0E; }

/* 展开箭头 */
.expand-arrow { font-size: 24rpx; color: #999; margin-left: 10rpx; }

/* 题目面板 */
.questions-panel {
  background: #FAFAFA; border-radius: 12rpx; padding: 20rpx; margin: 16rpx 0;
}
.q-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.q-title { font-size: 26rpx; font-weight: bold; color: #333; }
.q-add-btn { font-size: 24rpx; color: #DC2626; font-weight: bold; }
.q-list { display: flex; flex-direction: column; gap: 10rpx; }
.q-item {
  display: flex; align-items: flex-start; gap: 10rpx;
  background: #FFF; border-radius: 8rpx; padding: 14rpx 16rpx;
  border: 1rpx solid #EFEFEF;
}
.q-index { font-size: 24rpx; color: #999; flex-shrink: 0; margin-top: 2rpx; }
.q-text { flex: 1; font-size: 26rpx; color: #333; line-height: 1.4; }
.q-delete {
  font-size: 22rpx; color: #EF4444; flex-shrink: 0; padding: 4rpx 12rpx;
  background: #FEF2F2; border-radius: 6rpx;
}
.q-empty { text-align: center; padding: 30rpx; color: #999; font-size: 24rpx; }
.q-actions { margin-top: 16rpx; }
.q-save-btn {
  background: linear-gradient(135deg, #DC2626, #B91C1C);
  color: #FFF; border: none; border-radius: 8rpx; padding: 16rpx;
  font-size: 26rpx; text-align: center;
}
