page { background: #F5F5F5; min-height: 100vh; }
.page { min-height: 100vh; position: relative; overflow: hidden; }
.page-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }

.nav-header {
  background: linear-gradient(135deg,#F03038 0%,#ED1C24 50%,#D8171E 100%);
  width: 100%; height: 140rpx; display: flex; align-items: center;
  justify-content: space-between; padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box; position: fixed; top: 0; left: 0; right: 0; z-index: 100;
}
.nav-left { display: flex; align-items: center; z-index: 101; }
.nav-back { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.back-icon { font-size: 48rpx; color: #FFF; font-weight: bold; line-height: 1; }
.nav-title { display: flex; align-items: baseline; gap: 8rpx; }
.title-main { font-family: "MaoFont","STXingkai","KaiTi",serif; font-size: 60rpx; color: #FFF; font-weight: bold; }
.title-sub { font-size: 30rpx; color: #FFF; font-weight: bold; letter-spacing: 4rpx; }
.nav-right { display: flex; align-items: center; gap: 20rpx; }
.logo-flip-container { width: 80rpx; height: 80rpx; perspective: 1000rpx; }
.logo-card { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; }
.flip-animation { animation: logoFlip 4s ease-in-out infinite; }
@keyframes logoFlip {
  0%,40% { transform: rotateY(0deg); }
  50%,90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}
.logo-front,.logo-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.logo-front { background: #FFF; border-radius: 50%; overflow: hidden; }
.logo-image { width: 90%; height: 90%; }
.logo-back { background: linear-gradient(135deg,#F03038,#ED1C24); transform: rotateY(180deg); flex-direction: column; border: 2rpx solid #FFF; }
.school-name { font-size: 18rpx; color: #FFF; font-weight: bold; white-space: nowrap; }
.school-name-university { font-size: 18rpx; color: #FFF; font-weight: bold; margin-top: 2rpx; }

.container { position: relative; z-index: 1; min-height: 100vh; padding: 170rpx 30rpx 40rpx; box-sizing: border-box; }

/* ===== 测验选择 ===== */
.form-section {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx; padding: 24rpx 30rpx;
  margin-bottom: 20rpx; box-shadow: 0 4rpx 12rpx rgba(237,28,36,0.08);
}
.label { display: block; font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.form-picker {
  height: 80rpx; background: #f8f8f8; border-radius: 12rpx;
  padding: 0 20rpx; display: flex; align-items: center;
  justify-content: space-between; font-size: 28rpx;
}
.picker-arrow { font-size: 22rpx; color: #999; }

/* ===== 统计卡片 3x2 ===== */
.stats-grid {
  display: grid; grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx; margin-bottom: 20rpx;
}
.stat-mini {
  border-radius: 14rpx; padding: 20rpx 10rpx;
  text-align: center; display: flex; flex-direction: column; gap: 6rpx;
}
.stat-mini.blue { background: #e6f7ff; }
.stat-mini.green { background: #f6ffed; }
.stat-mini.gray { background: #f5f5f5; }
.stat-mini.orange { background: #fff7e6; }
.stat-mini.purple { background: #f9f0ff; }
.stat-mini.red { background: #fff2f0; }
.stat-mini.teal { background: #e6fffb; }
.mini-num { font-size: 36rpx; font-weight: bold; }
.stat-mini.blue .mini-num { color: #1890ff; }
.stat-mini.green .mini-num { color: #52c41a; }
.stat-mini.orange .mini-num { color: #fa8c16; }
.stat-mini.purple .mini-num { color: #722ed1; }
.stat-mini.red .mini-num { color: #ff4d4f; }
.stat-mini.teal .mini-num { color: #13c2c2; }
.mini-label { font-size: 22rpx; color: #999; }

/* ===== 图表区域 ===== */
.chart-section {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(237,28,36,0.08);
}
.chart-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.chart-title { font-size: 28rpx; font-weight: bold; color: #333; }
.toggle-wrap { display: flex; background: #f0f0f0; border-radius: 20rpx; overflow: hidden; }
.toggle-btn {
  padding: 8rpx 28rpx; font-size: 24rpx; color: #666;
  border-radius: 20rpx;
}
.toggle-btn.active { background: #F03038; color: #fff; font-weight: bold; }

/* ---- 柱状图 ---- */
.bar-chart-wrap { padding: 10rpx 0; }
.bars-container {
  display: flex; justify-content: space-around; align-items: flex-end;
  height: 420rpx; padding: 0 6rpx;
}
.bar-col {
  display: flex; flex-direction: column; align-items: center;
  flex: 1; height: 100%; justify-content: flex-end;
}
.bar-val { font-size: 20rpx; color: #666; margin-bottom: 6rpx; font-weight: bold; }
.bar-column {
  width: 64%; border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx; transition: height 0.5s ease;
}
.bar-tag { font-size: 22rpx; font-weight: bold; margin-top: 10rpx; }
.bar-pct { font-size: 20rpx; color: #999; margin-top: 2rpx; }

/* ---- 饼图 ---- */
.pie-chart-wrap {
  display: flex; flex-direction: column; align-items: center;
  padding: 20rpx 0;
}
.pie-circle {
  width: 340rpx; height: 340rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 30rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}
.pie-center {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  background: #fff; display: flex; align-items: center;
  justify-content: center; font-size: 26rpx;
  font-weight: bold; color: #333;
}
.pie-legend { width: 100%; }
.legend-row {
  display: flex; align-items: center; padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.legend-dot {
  width: 20rpx; height: 20rpx; border-radius: 4rpx; margin-right: 12rpx;
}
.legend-label { flex: 1; font-size: 24rpx; color: #666; }
.legend-val { font-size: 24rpx; color: #333; font-weight: bold; }

/* ===== 详细数据 ===== */
.detail-section {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(237,28,36,0.08);
}
.detail-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.detail-item {
  background: #f8f8f8; border-radius: 12rpx;
  padding: 18rpx; text-align: center;
}
.d-label { display: block; font-size: 22rpx; color: #999; margin-bottom: 6rpx; }
.d-value { font-size: 30rpx; font-weight: bold; color: #333; }
.d-value.warn { color: #ff4d4f; }

/* ---- 折线图 ---- */
.line-chart-wrap { padding: 20rpx 0; }
.line-chart-svg {
  width: 100%; height: 400rpx; background: #FAFBFC;
  border-radius: 16rpx; padding: 20rpx; box-sizing: border-box;
  position: relative; overflow: hidden;
}
.line-chart-area {
  position: relative; width: 100%; height: 320rpx;
  border-bottom: 2rpx solid #E5E7EB; border-left: 2rpx solid #E5E7EB;
}
.line-points { position: absolute; width: 100%; height: 100%; }
.line-dot {
  position: absolute; width: 16rpx; height: 16rpx;
  border-radius: 50%; transform: translate(-50%, 50%);
  box-shadow: 0 0 0 4rpx rgba(255,255,255,0.8);
  z-index: 2;
}
.line-dot::after {
  content: ''; position: absolute; bottom: -8rpx; left: 50%;
  width: 2rpx; height: 160rpx; background: #E5E7EB;
  transform: translateX(-50%);
}
.line-tag {
  position: absolute; bottom: -52rpx; transform: translateX(-50%);
  font-size: 20rpx; color: #333; font-weight: bold; white-space: nowrap;
}
.line-legend { width: 100%; margin-top: 10rpx; }

/* ===== 空状态 ===== */
.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 100rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }
