page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 导航栏样式 */
.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  z-index: 101;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  line-height: 1;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
  justify-content: center;
  align-items: center;
}

.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

.container {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 170rpx 30rpx 30rpx;
  box-sizing: border-box;
  background: transparent;
}

.tabs {
    display: flex;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1rpx solid #f7fafc;
    position: sticky;
    top: 0;
    z-index: 100;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.1);
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 30rpx 0;
    font-size: 28rpx;
    color: #718096;
    position: relative;
}

.tab-item.active {
    color: #F03038;
    font-weight: bold;
}

.tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80rpx;
    height: 4rpx;
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
    border-radius: 2rpx;
}

.tab-content {
    padding: 30rpx 0;
}

.stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20rpx;
    margin-bottom: 30rpx;
}

.stat-box {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20rpx;
    padding: 30rpx 20rpx;
    text-align: center;
    box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.1);
}

.stat-value {
    display: block;
    font-size: 40rpx;
    font-weight: bold;
    color: #F03038;
    margin-bottom: 10rpx;
}

.stat-label {
    display: block;
    font-size: 24rpx;
    color: #a0aec0;
}

.distribution-section {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20rpx;
    padding: 30rpx;
    box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.1);
}

.section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #2d3748;
    margin-bottom: 30rpx;
    padding-left: 20rpx;
    border-left: 4rpx solid #F03038;
}

.metrics-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20rpx;
    margin-bottom: 30rpx;
    padding: 30rpx;
    background: linear-gradient(135deg, #fff5f5 0%, #ffe6e6 100%);
    border-radius: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.1);
}

.metric-box {
    text-align: center;
}

.metric-label {
    display: block;
    font-size: 24rpx;
    color: #718096;
    margin-bottom: 10rpx;
}

.metric-value {
    display: block;
    font-size: 36rpx;
    font-weight: bold;
    color: #F03038;
}

.detail-table {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.1);
}

.table-header-row {
    display: flex;
    background: linear-gradient(135deg, #fff5f5 0%, #ffe6e6 100%);
    padding: 24rpx 20rpx;
    font-weight: bold;
    color: #2d3748;
    font-size: 24rpx;
    border-bottom: 1rpx solid #f7fafc;
}

.th-cell {
    flex: 1;
    text-align: center;
}

.th-cell:nth-child(6) {
    flex: 2;
}

.table-body {
    max-height: 600rpx;
    overflow-y: auto;
}

.table-row {
    display: flex;
    padding: 24rpx 20rpx;
    border-bottom: 1rpx solid #f7fafc;
    align-items: center;
    font-size: 24rpx;
}

.table-row:last-child {
    border-bottom: none;
}

.td-cell {
    flex: 1;
    text-align: center;
    color: #2d3748;
}

.td-cell:nth-child(6) {
    flex: 2;
    text-align: left;
}

.range-indicator {
    display: inline-block;
    width: 16rpx;
    height: 16rpx;
    border-radius: 50%;
    margin-right: 10rpx;
    vertical-align: middle;
}

.level-badge {
    display: inline-block;
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
    color: #fff;
    font-size: 22rpx;
}

.progress-bar {
    width: 100%;
    height: 24rpx;
    background: #f7fafc;
    border-radius: 12rpx;
    overflow: hidden;
    margin-bottom: 8rpx;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #F03038, #ED1C24);
    border-radius: 12rpx;
    transition: width 0.3s ease;
}

.progress-text {
    font-size: 22rpx;
    color: #718096;
}

.suggestion {
    font-size: 22rpx;
    color: #718096;
    line-height: 1.5;
}

.search-box {
    background: rgba(255, 255, 255, 0.95);
    padding: 20rpx;
    margin-bottom: 20rpx;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.1);
}

.search-input {
    background: #f7fafc;
    padding: 16rpx 24rpx;
    border-radius: 16rpx;
    font-size: 26rpx;
}

.table-container {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20rpx;
    overflow: hidden;
    max-height: calc(100vh - 300rpx);
    box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.1);
}

.table-header {
    display: flex;
    background: linear-gradient(135deg, #fff5f5 0%, #ffe6e6 100%);
    padding: 24rpx 20rpx;
    font-weight: bold;
    color: #2d3748;
    font-size: 24rpx;
    border-bottom: 1rpx solid #f7fafc;
}

.th {
    flex: 1;
    text-align: center;
}

.table-row-detail {
    display: flex;
    padding: 24rpx 20rpx;
    border-bottom: 1rpx solid #f7fafc;
    align-items: center;
    font-size: 24rpx;
}

.table-row-detail:last-child {
    border-bottom: none;
}

.td {
    flex: 1;
    text-align: center;
    color: #2d3748;
}

.student-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
}

.avatar-circle {
    width: 48rpx;
    height: 48rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
}

.score.excellent {
    color: #52c41a;
    font-weight: bold;
}

.score.pass {
    color: #1890ff;
    font-weight: bold;
}

.score.fail {
    color: #ff4d4f;
    font-weight: bold;
}

.status-badge {
    display: inline-block;
    padding: 6rpx 16rpx;
    background: #f6ffed;
    color: #52c41a;
    border: 1rpx solid #b7eb8f;
    border-radius: 20rpx;
    font-size: 22rpx;
}

.action-btns {
    display: flex;
    justify-content: center;
    gap: 16rpx;
}

.icon-btn {
    font-size: 32rpx;
    padding: 8rpx;
}

.empty-state {
    text-align: center;
    padding: 100rpx 0;
    color: #a0aec0;
}
