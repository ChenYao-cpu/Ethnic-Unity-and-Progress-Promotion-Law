@import '../../styles/iconfont.wxss';

page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  z-index: 101;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  line-height: 1;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.score-label-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.score-label-vertical text {
  font-size: 22rpx;
  color: #FFD700;
  font-weight: 500;
  line-height: 1;
}

.score-value {
  font-size: 40rpx;
  color: #FFD700;
  font-weight: bold;
  font-family: "Arial", sans-serif;
}

.divider {
  width: 2rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 1rpx;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
  justify-content: center;
  align-items: center;
}

.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

/* 横向筛选器 */
.category-filter {
  background: rgba(255, 255, 255, 0.9);
  padding: 50rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-top: 140rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #333;
  border-radius: 30rpx;
  background: #f5f5f5;
  transition: all 0.3s ease;
}

.filter-item.active {
  background: #ED1C24;
  color: #fff;
  font-weight: bold;
}

/* 竖向课程列表 - 只显示封面，无右边空白 */
.course-list {
  flex: 1;
  padding: 0 30rpx 30rpx;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 课程卡片 - 移除flex布局，只显示封面 */
.course-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.course-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* 封面容器 - 填满整个卡片宽度 */
.course-cover {
  position: relative;
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.cover-image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  object-fit: cover;
}

.play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon::before {
  content: '';
  width: 0;
  height: 0;
  border-left: 24rpx solid #fff;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  margin-left: 6rpx;
}

/* 视频容器 */
.video-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  background: #000;
  z-index: 200;
}

/* 视频播放器 */
.video-player {
  width: 100%;
  height: 100%;
  background: #000;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 199;
}


/* 视频导航栏 */
.video-nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;  /* 与 .nav-header 保持一致 */
  box-sizing: border-box;
  z-index: 201;
}

.video-nav-header .nav-left {
  display: flex;  /* 改为 flex，与主页导航栏一致 */
  align-items: center;
  z-index: 101;  /* 与主页导航栏一致 */
  position: relative;  /* 改为相对定位 */
  left: auto;
  top: auto;
  width: auto;  /* 宽度自适应 */
  height: auto;
}

.video-nav-header .nav-left .back-icon1 {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
  margin-left: 0;  /* 父容器 padding 已提供左边距 */
}

.video-nav-header .nav-title {
  position: absolute;
  left: 50%;
  top: 70%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 5;
}

.video-nav-header .title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.video-nav-header .nav-right {
  width: 50%;
}


/* 首次观看提示 */
.first-watch-tip {
  position: fixed;
  bottom: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(211, 47, 47, 0.9);
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  z-index: 202;
  white-space: nowrap;
}

/* 播放进度提示 */
.play-progress-tip {
  position: fixed;
  bottom: 140rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  z-index: 202;
}

.play-progress-tip .progress-percent {
  color: #FFD700;
  font-weight: bold;
}

/* 横屏模式下的样式 */
@media screen and (orientation: landscape) {
  .video-nav-header {
    display: none;
  }

  .fullscreen-btn {
    top: 20rpx;
    right: 20rpx;
  }

  .first-watch-tip {
    bottom: 120rpx;
  }

  .play-progress-tip {
    bottom: 60rpx;
  }
}.course-cover-skeleton{position:absolute;inset:0;background:#e5e4e2;animation:cover-pulse 1.4s ease-in-out infinite;z-index:1;}.course-cover-fallback{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;padding:24rpx;background:#f4e8de;color:#791817;text-align:center;font-size:30rpx;}.course-cover-fallback .yj-icon{font-size:64rpx;}@keyframes cover-pulse{50%{opacity:.45}}@media(prefers-reduced-motion:reduce){.course-cover-skeleton{animation:none}}
