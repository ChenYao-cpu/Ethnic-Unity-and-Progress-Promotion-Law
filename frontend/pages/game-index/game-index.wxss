@import '../../styles/iconfont.wxss';

page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  z-index: 101;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  line-height: 1;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.score-label-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.score-label-vertical text {
  font-size: 22rpx;
  color: #FFD700;
  font-weight: 500;
  line-height: 1;
}
.score-value {
  font-size: 40rpx;
  color: #FFD700;
  font-weight: bold;
  font-family: "Arial", sans-serif;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
  justify-content: center;
  align-items: center;
}

.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding-top: 160rpx;
}

.game-list {
  background: rgba(255, 255, 255, 0.95);
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.12);
}

.game-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 55rpx 40rpx;
  background: linear-gradient(135deg, #FFD700 0%, #ED1C24 50%, #D8171E 100%);
  border-radius: 20rpx;
  transition: all 0.3s ease;
  box-shadow: 0 6rpx 20rpx rgba(237, 28, 36, 0.4);
  box-sizing: border-box;
  transform: scale(1.05);
}

.game-item:active {
  transform: scale(1.02);
  box-shadow: 0 3rpx 10rpx rgba(237, 28, 36, 0.3);
}

.game-item.full-width {
  width: 100%;
}

.game-row {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.game-item.half-width {
  width: 100%;
  padding: 55rpx 40rpx;
}

.game-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 0;
  justify-content: flex-start;
}

.game-icon {
  font-size: 60rpx;
  color: #FFF;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.game-text {
  font-size: 36rpx;
  color: #FFF;
  font-weight: 600;
  letter-spacing: 2rpx;
  white-space: nowrap;
  line-height: 1;
}

.game-arrow {
  font-size: 48rpx;
  color: #FFF;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: auto;
  display: flex;
  align-items: center;
  line-height: 1;
}
/* 法条匹配 - 图标左移，文字多移 */
.game-list > .game-item:nth-child(1) .game-icon {
  margin-left: 25rpx;
}
.game-list > .game-item:nth-child(1) .game-text {
  margin-left: 35rpx;
}

/* 法条对战 */
.game-list > .game-row:nth-child(2) > .game-item:nth-child(1) .game-icon {
  margin-left: 25rpx;
}
.game-list > .game-row:nth-child(2) > .game-item:nth-child(1) .game-text {
  margin-left: 35rpx;
}

/* 情景模拟 */
.game-list > .game-row:nth-child(2) > .game-item:nth-child(2) .game-icon {
  margin-left: 25rpx;
}
.game-list > .game-row:nth-child(2) > .game-item:nth-child(2) .game-text {
  margin-left: 35rpx;
}

/* 勋章墙 */
.game-list > .game-row:nth-child(3) > .game-item:nth-child(2) .game-icon {
  margin-left: 25rpx;
}
.game-list > .game-row:nth-child(3) > .game-item:nth-child(2) .game-text {
  margin-left: 35rpx;
}
.game-item.leaderboard-btn {
  background: linear-gradient(135deg, #FFD700 0%, #FF8C00 50%, #ED1C24 100%);
  padding: 55rpx 40rpx;
}

.game-item.achievement-btn {
  background: linear-gradient(135deg, #FFA500 0%, #ED1C24 50%, #D8171E 100%);
  padding: 55rpx 40rpx;
}
