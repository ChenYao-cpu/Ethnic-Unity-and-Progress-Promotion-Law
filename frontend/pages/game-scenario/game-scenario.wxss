@import '../../styles/iconfont.wxss';

page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 导航栏样式 - 与首页一致 */
.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  z-index: 101;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  line-height: 1;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.score-label-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.score-label-vertical text {
  font-size: 22rpx;
  color: #FFD700;
  font-weight: 500;
  line-height: 1;
}
.score-value {
  font-size: 40rpx;
  color: #FFD700;
  font-weight: bold;
  font-family: "Arial", sans-serif;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
  justify-content: center;
  align-items: center;
}


.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 160rpx 20rpx 20rpx;
}

.empty-state {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.15);
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.progress-bar {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.15);
}

.progress-text {
  font-size: 28rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  text-align: center;
  margin-bottom: 12rpx;
}

.progress-line {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.scenario-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.15);
}

.scenario-icon {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.scenario-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ED1C24;
  margin-bottom: 15rpx;
  text-align: center;
}

.scenario-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 25rpx;
  padding: 20rpx;
  background: rgba(237, 28, 36, 0.05);
  border-radius: 12rpx;
  border-left: 4rpx solid #ED1C24;
}


.scenario-image {
    width: 100%;
    margin: 15rpx 0 20rpx;
    border-radius: 12rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.question-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.no-options-tip {
  padding: 30rpx;
  background: #fffbe6;
  border: 2rpx solid #ffe58f;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #d48806;
}

.option {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 2rpx solid #f0f0f0;
  transition: all 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.option.selected {
  border-color: #ED1C24;
  background: rgba(237, 28, 36, 0.08);
  box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.2);
}

.option-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #ED1C24;
  margin-right: 10rpx;
}

.option-text {
  font-size: 26rpx;
  color: #333;
}

.knowledge-tip {
  padding: 15rpx;
  background: rgba(250, 173, 20, 0.1);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tip-icon {
  font-size: 24rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #d48806;
}

.result-panel {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.15);
}

.result-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.result-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  margin-bottom: 15rpx;
}

.result-stats {
  margin-bottom: 40rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.stat-label {
  font-size: 28rpx;
  color: #666;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.bonus-row {
  border-top: 2rpx dashed rgba(237,28,36,0.2);
  padding-top: 16rpx;
}

.bonus-value {
  background: linear-gradient(135deg, #FF9800 0%, #FF5722 100%) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  background-clip: text !important;
  font-size: 30rpx !important;
}

/* 逐题详情 */
.detail-section {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #eee;
}

.detail-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.detail-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  background: #fafafa;
  border-radius: 14rpx;
  border-left: 6rpx solid #eee;
}

.detail-status {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  flex-shrink: 0;
  color: #fff;
}

.status-right {
  background: #4CAF50;
  border-left-color: #4CAF50;
}

.status-wrong {
  background: #F03038;
  border-left-color: #F03038;
}

.detail-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-scenario {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.detail-answers {
  display: flex;
  gap: 24rpx;
}

.detail-your {
  font-size: 24rpx;
  color: #F03038;
}

.detail-correct {
  font-size: 24rpx;
  color: #4CAF50;
  font-weight: bold;
}

.detail-analysis {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.5;
  margin-top: 4rpx;
}

.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  padding: 26rpx;
  border-radius: 15rpx;
  font-size: 28rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.btn::after {
  border: none;
}

.btn-restart {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: white;
}

.btn-back {
  background: rgba(237, 28, 36, 0.1);
  color: #ED1C24;
}

