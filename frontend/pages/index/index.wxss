@import '../../styles/iconfont.wxss';

page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 导航栏样式 */
.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.score-label-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.score-label-vertical text {
  font-size: 22rpx;
  color: #FFD700;
  font-weight: 500;
  line-height: 1;
}

.score-value {
  font-size: 40rpx;
  color: #FFD700;
  font-weight: bold;
  font-family: "Arial", sans-serif;
}

.divider {
  width: 2rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 1rpx;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  }

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
  justify-content: center;
  align-items: center;
}

.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding-top: 160rpx;
}

/* 催促提醒通知条 */
.reminder-banner {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 30rpx 20rpx; padding: 20rpx 24rpx;
  background: linear-gradient(135deg,#fff2f0,#fff7e6);
  border: 2rpx solid #ffccc7; border-radius: 14rpx;
}
.reminder-banner-left { display: flex; align-items: center; gap: 12rpx; }
.reminder-icon { font-size: 32rpx; }
.reminder-banner-text { font-size: 26rpx; color: #cf1322; font-weight: bold; }
.reminder-arrow { font-size: 32rpx; color: #ff4d4f; }

.grid-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
}

.action-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 12rpx;
}

.action-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
  font-size: 80rpx;
  color: #ED1C24;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(237, 28, 36, 0.1);
  border-radius: 20rpx;
}

.action-text {
  font-size: 24rpx;
  color: #333;
}

.section-wrapper {
  background: rgba(255, 255, 255, 0.92);
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #ED1C24;
  display: flex; align-items: center;
}
.unread-badge {
  display: inline-block; background: #ED1C24; color: #FFF;
  min-width: 32rpx; height: 32rpx; line-height: 32rpx;
  text-align: center; border-radius: 16rpx;
  font-size: 20rpx; font-weight: bold; margin-left: 6rpx; padding: 0 6rpx;
}
.my-quiz-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.2);
}

.my-quiz-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.my-quiz-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.my-quiz-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.arrow {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
}
.notice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  background: #ED1C24;
  border-radius: 50%;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
}

.notice-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.notice-date {
  font-size: 22rpx;
  color: #999;
  display: block;
}
/* 最新测验列表 - 红色系 */
.exam-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.exam-item {
  background: linear-gradient(135deg, #FFF5F5 0%, #FFEBEB 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.3s ease;
  border-left: 8rpx solid #ED1C24;
  box-shadow: 0 2rpx 8rpx rgba(237, 28, 36, 0.1);
}

.exam-item:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #FFEBEB 0%, #FFE0E0 100%);
}

.exam-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #ED1C24, #F03038);
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.3);
}



.exam-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.exam-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.exam-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.exam-teacher {
  font-size: 24rpx;
  color: #ED1C24;
  font-weight: 500;
}

.exam-date {
  font-size: 22rpx;
  color: #999;
}

.exam-tag {
  background: linear-gradient(135deg, #ED1C24, #F03038);
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(237, 28, 36, 0.3);
}

.empty-tip {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}
/* Yunjiang original visual system */
page,.page{background:#FAF7EB;}
.page-bg{display:none;}
.nav-header{background:#791817;}
.title-main{font-family:PingFang SC,Microsoft YaHei,sans-serif;font-size:42rpx;letter-spacing:4rpx;}
.title-sub{font-size:22rpx;letter-spacing:1rpx;font-weight:400;}
.score-display .score-value,.score-display .score-label-vertical text{color:#FAF7EB;}
.action-card{background:#fffdf8;border:1rpx solid #F0D3CC;box-shadow:none;}
.action-icon{color:#791817!important;}
.action-text,.section-title{color:#791817;}
.section-wrapper{background:#fffdf8;border:1rpx solid #F0D3CC;box-shadow:none;}
.section-more{color:#791817;}

/* Six functional entry icons in the brand palette. */
.action-card{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14rpx;}
.feature-icon{display:block;width:116rpx;height:116rpx;flex-shrink:0;}
.action-card .action-text{color:#791817;font-size:26rpx;line-height:1.5;text-align:center;}
