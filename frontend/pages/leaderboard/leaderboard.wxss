page { background: #f5f5f5; }

.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx; height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon { font-size: 48rpx; color: #fff; font-weight: bold; }

.nav-title { display: flex; align-items: baseline; gap: 8rpx; }
.title-main { font-size: 60rpx; color: #fff; font-weight: bold; }
.title-sub { font-size: 30rpx; color: #fff; font-weight: bold; letter-spacing: 4rpx; }

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-display { display: flex; align-items: center; gap: 12rpx; }
.score-label-vertical { display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.score-label-vertical text { font-size: 22rpx; color: #FFD700; font-weight: 500; line-height: 1; }
.score-value { font-size: 40rpx; color: #FFD700; font-weight: bold; }

/* 学校翻转logo */
.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
}

.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

/* 内容区域 */
.content {
  padding: 20rpx;
  margin-top: 140rpx;
}

.loading-box { text-align: center; padding: 100rpx 0; color: #666; }

.list { background: #fff; border-radius: 16rpx; padding: 16rpx; }

.item {
  display: flex; align-items: center; padding: 20rpx; margin-bottom: 10rpx;
  background: #f8f9fc; border-radius: 12rpx;
}
.item.first { background: linear-gradient(135deg, rgba(255,215,0,0.15), rgba(255,165,0,0.15)); border: 2rpx solid #FFD700; }
.item.me { border: 2rpx solid #f5576c; }

.rank { width: 60rpx; font-size: 32rpx; font-weight: bold; color: #F03038; text-align: center; }

.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; margin: 0 16rpx; }

.info { flex: 1; }
.name { font-size: 28rpx; font-weight: bold; color: #333; }
.school { font-size: 22rpx; color: #999; display: block; }

.pts { font-size: 32rpx; font-weight: bold; color: #f5576c; }

.empty { text-align: center; padding: 100rpx 0; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #999; display: block; }
.empty-desc { font-size: 24rpx; color: #bbb; display: block; margin: 8rpx 0 24rpx; }
.btn { display: inline-block; padding: 16rpx 48rpx; background: #F03038; border-radius: 40rpx; }
.btn-text { font-size: 26rpx; color: #fff; }
