@import '../../styles/iconfont.wxss';

page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  z-index: 101;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  line-height: 1;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.score-label-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.score-label-vertical text {
  font-size: 22rpx;
  color: #FFD700;
  font-weight: 500;
  line-height: 1;
}

.score-value {
  font-size: 40rpx;
  color: #FFD700;
  font-weight: bold;
  font-family: "Arial", sans-serif;
}
.divider {
  width: 2rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 1rpx;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
  justify-content: center;
  align-items: center;
}

.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding-top: 160rpx;
  padding-bottom: 140rpx;
}

.title-input {
  background: rgba(255, 255, 255, 0.92);
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.title-field {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.editor-container {
  background: rgba(255, 255, 255, 0.92);
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  min-height: 400rpx;
}

.content-editor {
  width: 100%;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  min-height: 300rpx;
}

.image-list {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.note-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-image {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #FF5722;
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

/* 左下角编辑按钮 */
.edit-button {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  width: 200rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 99;
  transition: all 0.3s;
  border: 2rpx solid #E0E0E0;
}

.edit-button.active {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.4);
}

.edit-button:active {
  transform: scale(0.95);
}

.edit-icon {
  font-size: 36rpx;
  color: #ED1C24;
}

.edit-button.active .edit-icon {
  color: #FFF;
}

.edit-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.edit-button.active .edit-text {
  color: #FFF;
}

/* 底部工具栏 */
.toolbar {
  position: fixed;
  bottom: 140rpx;
  left: 40rpx;
  right: auto;
  width: 200rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 16rpx;
  z-index: 98;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
  border-radius: 20rpx;
  transform: translateY(300rpx);
  opacity: 0;
  transition: all 0.3s ease-in-out;
}

.toolbar.show {
  transform: translateY(0);
  opacity: 1;
}

.tool-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tool-btn {
  width: 100%;
  height: 70rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: rgba(237, 28, 36, 0.08);
  border-radius: 35rpx;
  border: 2rpx solid rgba(237, 28, 36, 0.2);
  transition: all 0.3s;
}

.tool-btn.active {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.3);
}

.tool-btn:active {
  transform: scale(0.95);
}

.tool-icon {
  font-size: 32rpx;
  color: #ED1C24;
}

.tool-btn.active .tool-icon {
  color: #FFF;
}

.tool-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.tool-btn.active .tool-text {
  color: #FFF;
}

/* 右下角保存按钮 */
.save-button {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 200rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  border-radius: 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.4);
  z-index: 99;
  transition: all 0.3s;
}

.save-button:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.3);
}

.save-icon {
  font-size: 36rpx;
  color: #FFF;
}

.save-text {
  font-size: 28rpx;
  color: #FFF;
  font-weight: 500;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: none;
  align-items: center;
  justify-content: center;
}

.modal.show {
  display: flex;
}

.modal-content {
  width: 600rpx;
  background: #FFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1;
}

.font-list {
  max-height: 600rpx;
  overflow-y: auto;
  padding: 20rpx;
}

.font-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(237, 28, 36, 0.05);
  border-radius: 12rpx;
  text-align: center;
  font-size: 32rpx;
  color: #333;
  border: 2rpx solid rgba(237, 28, 36, 0.1);
}

.font-item.selected {
  border-color: #ED1C24;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF;
  font-weight: bold;
}

.font-item:active {
  background: rgba(237, 28, 36, 0.1);
}

.color-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 30rpx;
}

.color-item {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.color-item.selected {
  border-color: #ED1C24;
  box-shadow: 0 0 0 4rpx rgba(237, 28, 36, 0.3);
}

.check-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}
