

page {
    background: #F5F5F5;
    min-height: 100vh;
}

.page {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
}

.page-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

.nav-header {
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
    width: 100%;
    height: 140rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 50rpx 30rpx 0 30rpx;
    box-sizing: border-box;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
}

.nav-left {
    display: flex;
    align-items: center;
    z-index: 101;
}

.nav-back {
    width: 80rpx;
    height: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    z-index: 101;
}

.back-icon {
    font-size: 48rpx;
    color: #FFF;
    font-weight: bold;
    line-height: 1;
}

.back-hover {
    opacity: 0.7;
}

.nav-title {
    display: flex;
    align-items: baseline;
    gap: 8rpx;
}

.title-main {
    font-family: "MaoFont", "STXingkai", "KaiTi", serif;
    font-size: 60rpx;
    color: #FFF;
    font-weight: bold;
    letter-spacing: 0rpx;
}

.title-sub {
    font-size: 30rpx;
    color: #FFF;
    font-weight: bold;
    letter-spacing: 4rpx;
}

.nav-right {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.score-display {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.score-label-vertical {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rpx;
}

.score-label-vertical text {
    font-size: 22rpx;
    color: #FFD700;
    font-weight: 500;
    line-height: 1;
}

.score-value {
    font-size: 40rpx;
    color: #FFD700;
    font-weight: bold;
    font-family: "Arial", sans-serif;
}

.divider {
    width: 2rpx;
    height: 36rpx;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 1rpx;
}

.logo-flip-container {
    width: 80rpx;
    height: 80rpx;
    perspective: 1000rpx;
}

.logo-card {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
}

.flip-animation {
    animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
    0%, 40% { transform: rotateY(0deg); }
    50%, 90% { transform: rotateY(180deg); }
    100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.logo-front {
    background: #FFF;
    border-radius: 50%;
    overflow: hidden;
}

.logo-image {
    width: 90%;
    height: 90%;
}

.logo-back {
    background: linear-gradient(135deg, #F03038, #ED1C24);
    transform: rotateY(180deg);
    flex-direction: column;
    border: 2rpx solid #FFF;
    justify-content: center;
    align-items: center;
}

.school-name {
    font-family: "MaoFont", "STXingkai", "KaiTi", serif;
    font-size: 18rpx;
    color: #FFF;
    font-weight: bold;
    white-space: nowrap;
}

.school-name-university {
    font-family: "MaoFont", "STXingkai", "KaiTi", serif;
    font-size: 18rpx;
    color: #FFF;
    font-weight: bold;
    margin-top: 2rpx;
}

.content-wrapper {
    position: relative;
    z-index: 1;
    padding-top: 160rpx;
}

.section-wrapper {
    background: rgba(255, 255, 255, 0.92);
    margin: 0 20rpx 20rpx;
    border-radius: 16rpx;
    padding: 40rpx 30rpx;
}

.detail-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    line-height: 1.6;
    margin-bottom: 20rpx;
    text-align: center;
}

.detail-date {
    font-size: 24rpx;
    color: #999;
    text-align: center;
    margin-bottom: 30rpx;
}

.detail-divider {
    height: 2rpx;
    background: linear-gradient(to right, transparent, #ED1C24, transparent);
    margin-bottom: 30rpx;
}

.detail-content {
    line-height: 1.8;
}

.content-text {
    font-size: 28rpx;
    color: #666;
    white-space: pre-wrap;
    word-break: break-all;
    line-height: 2;
    text-align: justify;
}
