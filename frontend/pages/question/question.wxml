<view class="page">
  <image class="page-bg" src="/images/backgrounds/index-bg.png" mode="aspectFill"></image>

  <view class="nav-header">
    <view class="nav-left">
      <view class="nav-back" bindtap="goBack" hover-class="back-hover">
        <text class="back-icon">‹</text>
      </view>
    </view>
    <view class="nav-title">
      <text class="title-main">学习</text>
      <text class="title-sub">笔记</text>
    </view>
    <view class="nav-right">
      <view class="score-display">
        <view class="score-label-vertical">
          <text>积</text>
          <text>分</text>
        </view>
        <text class="score-value">{{score}}</text>
      </view>
      <view class="divider"></view>
      <view class="logo-flip-container">
        <view class="logo-card flip-animation">
          <view class="logo-front">
            <image class="logo-image" src="/images/brand/app-icon-192.png" mode="aspectFit"></image>
          </view>
          <view class="logo-back">
            <text class="school-name">西南民族</text>
            <text class="school-name-university">大学</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="content-wrapper">
    <view class="progress-bar">
      <view class="progress-text">{{currentIndex + 1}} / {{questions.length}}</view>
      <view class="progress-line">
        <view class="progress-fill" style="width: {{(currentIndex + 1) / questions.length * 100}}%"></view>
      </view>
    </view>

    <view class="question-card" wx:if="{{questions[currentIndex]}}">
      <view class="question-type">
        {{questions[currentIndex].type === 1 ? '单选题' : questions[currentIndex].type === 2 ? '多选题' : questions[currentIndex].type === 4 ? '情景题' : '判断题'}}
      </view>

      <image wx:if="{{questions[currentIndex].image}}" class="question-image" src="{{questions[currentIndex].image}}" mode="aspectFill"></image>
      <view class="question-title">{{questions[currentIndex].title || questions[currentIndex].questionText || questions[currentIndex].question}}</view>

      <view class="options">
        <view class="option {{userAnswer === item.key ? 'selected' : ''}} {{showResult && item.key === questions[currentIndex].answer ? 'correct' : ''}} {{showResult && userAnswer === item.key && !isCorrect ? 'wrong' : ''}}"
              wx:for="{{questions[currentIndex].options}}" wx:key="key"
              data-answer="{{item.key}}" bindtap="selectAnswer">
          <text class="option-key">{{item.key}}.</text>
          <text class="option-value">{{item.value}}</text>
        </view>
      </view>

      <view class="result" wx:if="{{showResult}}">
        <view class="result-text {{isCorrect ? 'correct' : 'wrong'}}">
          {{isCorrect ? '✓ 回答正确' : '✗ 回答错误'}}
        </view>
        <view class="analysis" wx:if="{{questions[currentIndex].analysis}}">
          <text class="analysis-title">解析：</text>
          <text>{{questions[currentIndex].analysis}}</text>
        </view>
      </view>

      <button class="submit-btn" wx:if="{{!showResult}}" bindtap="submitAnswer">提交答案</button>
      <button class="next-btn" wx:if="{{showResult}}" bindtap="nextQuestion">
        {{currentIndex < questions.length - 1 ? '下一题' : '查看结果'}}
      </button>
    </view>
  </view>
</view>

<view wx:if="{{showResult}}"><button bindtap="openTutor">AI针对性辅导</button></view>
