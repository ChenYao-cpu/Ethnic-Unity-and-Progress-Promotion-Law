@import '../../styles/iconfont.wxss';

page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
  z-index: 101;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  z-index: 101;
}

.back-hover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 48rpx;
  color: #FFF;
  font-weight: bold;
  line-height: 1;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.score-label-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.score-label-vertical text {
  font-size: 22rpx;
  color: #FFD700;
  font-weight: 500;
  line-height: 1;
}

.score-value {
  font-size: 40rpx;
  color: #FFD700;
  font-weight: bold;
  font-family: "Arial", sans-serif;
}

.divider {
  width: 2rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 1rpx;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
  justify-content: center;
  align-items: center;
}

.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

.content-wrapper {
  position: relative;
  z-index: 1;
  padding: 180rpx 20rpx 30rpx;
}

.progress-bar {
  background: rgba(255, 255, 255, 0.92);
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.progress-line {
  height: 12rpx;
  background: #E0E0E0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  transition: width 0.3s;
}

.question-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16rpx;
  padding: 30rpx;
}

.question-type {
  display: inline-block;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.question-title {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 30rpx;
  font-weight: 500;
}

.question-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  max-height: 300rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.option {
  padding: 24rpx;
  background: rgba(237, 28, 36, 0.05);
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.option.selected {
  border-color: #ED1C24;
  background: rgba(237, 28, 36, 0.1);
}

.option.correct {
  border-color: #4CAF50;
  background: rgba(76, 175, 80, 0.1);
}

.option.wrong {
  border-color: #FF5722;
  background: rgba(255, 87, 34, 0.1);
}

.option-key {
  font-size: 28rpx;
  font-weight: bold;
  color: #ED1C24;
  margin-right: 12rpx;
}

.option-value {
  font-size: 28rpx;
  color: #333;
}

.result {
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.result-text {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.result-text.correct {
  color: #4CAF50;
}

.result-text.wrong {
  color: #FF5722;
}

.analysis {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.analysis-title {
  font-weight: bold;
  color: #333;
}

.submit-btn, .next-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}

.next-btn {
  background: linear-gradient(135deg, #FFD700 0%, #FFC107 100%);
  color: #333;
}
