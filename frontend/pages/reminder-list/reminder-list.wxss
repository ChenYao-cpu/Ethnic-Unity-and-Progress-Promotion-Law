page { background: #F5F5F5; min-height: 100vh; }
.page { min-height: 100vh; position: relative; overflow: hidden; }
.page-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }

.nav-header {
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
    width: 100%; height: 140rpx; display: flex; align-items: center;
    justify-content: space-between; padding: 50rpx 30rpx 0 30rpx;
    box-sizing: border-box; position: fixed; top: 0; left: 0; right: 0; z-index: 100;
}
.nav-left { display: flex; align-items: center; }
.nav-back { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 48rpx; color: #FFF; font-weight: bold; }
.nav-title { display: flex; align-items: baseline; gap: 8rpx; }
.title-main { font-family: "MaoFont", "STXingkai", "KaiTi", serif; font-size: 60rpx; color: #FFF; font-weight: bold; }
.title-sub { font-size: 30rpx; color: #FFF; font-weight: bold; letter-spacing: 4rpx; }

.nav-right { display: flex; align-items: center; gap: 16rpx; }
.score-display { display: flex; flex-direction: column; align-items: center; }
.score-label-vertical { display: flex; flex-direction: column; align-items: center; line-height: 1; }
.score-label-vertical text { font-size: 18rpx; color: #FFF; }
.score-value { font-size: 28rpx; color: #FFF; font-weight: bold; margin-top: 2rpx; }
.divider { width: 1rpx; height: 60rpx; background: rgba(255,255,255,0.3); }
.logo-flip-container { width: 80rpx; height: 80rpx; perspective: 1000rpx; }
.logo-card { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; animation: flip 3s infinite; }
.logo-front, .logo-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.logo-front { background: transparent; }
.logo-image { width: 100%; height: 100%; border-radius: 50%; }
.logo-back { background: rgba(255,255,255,0.9); transform: rotateY(180deg); flex-direction: column; }
.school-name { font-size: 16rpx; color: #ED1C24; font-weight: bold; }
.school-name-university { font-size: 14rpx; color: #ED1C24; }
@keyframes flip { 0%, 40% { transform: rotateY(0); } 50%, 90% { transform: rotateY(180deg); } 100% { transform: rotateY(0); } }

.content-wrapper { position: relative; z-index: 1; min-height: 100vh; padding: 170rpx 30rpx 30rpx; box-sizing: border-box; }
.section-wrapper { background: #fff; border-radius: 24rpx; padding: 30rpx; margin-bottom: 30rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05); }
.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30rpx; padding-bottom: 20rpx; border-bottom: 2rpx solid #f5f5f5; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333; position: relative; padding-left: 20rpx; }
.section-title::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 6rpx; height: 28rpx; background: #ED1C24; border-radius: 3rpx; }
.section-more { font-size: 26rpx; color: #ED1C24; }

.notice-list { display: flex; flex-direction: column; gap: 20rpx; }
.notice-item { display: flex; align-items: center; padding: 24rpx; background: #fafafa; border-radius: 12rpx; transition: all 0.3s; }
.notice-item:active { background: #f0f0f0; transform: scale(0.98); }
.notice-dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex-shrink: 0; margin-right: 16rpx; }
.notice-content { flex: 1; }
.notice-title { font-size: 28rpx; color: #333; display: block; margin-bottom: 8rpx; line-height: 1.4; }
.notice-date { font-size: 22rpx; color: #999; }
.notice-status { font-size: 24rpx; flex-shrink: 0; margin-left: 16rpx; }

.empty-tip { text-align: center; padding: 100rpx 0; color: #999; font-size: 28rpx; }
