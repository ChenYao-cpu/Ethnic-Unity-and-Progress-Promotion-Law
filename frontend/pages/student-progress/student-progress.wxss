page { background: #F5F5F5; min-height: 100vh; }
.page { min-height: 100vh; position: relative; overflow: hidden; }
.page-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }

/* 导航栏 */
.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%; height: 140rpx; display: flex; align-items: center;
  justify-content: space-between; padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box; position: fixed; top: 0; left: 0; right: 0; z-index: 100;
}
.nav-left { display: flex; align-items: center; z-index: 101; }
.nav-back { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 48rpx; color: #FFF; font-weight: bold; line-height: 1; }
.nav-title { display: flex; align-items: baseline; gap: 8rpx; }
.title-main { font-family: "MaoFont","STXingkai","KaiTi",serif; font-size: 60rpx; color: #FFF; font-weight: bold; }
.title-sub { font-size: 30rpx; color: #FFF; font-weight: bold; letter-spacing: 4rpx; }
.nav-right { display: flex; align-items: center; gap: 20rpx; }
.logo-flip-container { width: 80rpx; height: 80rpx; perspective: 1000rpx; }
.logo-card { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; }
.flip-animation { animation: logoFlip 4s ease-in-out infinite; }
@keyframes logoFlip {
  0%,40% { transform: rotateY(0deg); }
  50%,90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}
.logo-front,.logo-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.logo-front { background: #FFF; border-radius: 50%; overflow: hidden; }
.logo-image { width: 90%; height: 90%; }
.logo-back { background: linear-gradient(135deg,#F03038,#ED1C24); transform: rotateY(180deg); flex-direction: column; border: 2rpx solid #FFF; }
.school-name { font-size: 18rpx; color: #FFF; font-weight: bold; }
.school-name-university { font-size: 18rpx; color: #FFF; font-weight: bold; margin-top: 2rpx; }

.container { position: relative; z-index: 1; min-height: 100vh; padding: 170rpx 30rpx 40rpx; box-sizing: border-box; }

/* ========== 测验选择 ========== */
.form-section {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(237,28,36,0.08);
}
.form-item { }
.label { display: block; font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.form-picker {
  height: 80rpx; background: #f8f8f8; border-radius: 12rpx;
  padding: 0 20rpx; display: flex; align-items: center;
  justify-content: space-between; font-size: 28rpx;
}
.picker-arrow { font-size: 22rpx; color: #999; }

/* ========== 进度概览卡片 ========== */
.overview-section {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(237,28,36,0.08);
}
.overview-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 20rpx; }
.overview-card {
  border-radius: 14rpx; padding: 24rpx 16rpx; text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
}
.overview-card.total { background: #e6f7ff; }
.overview-card.done { background: #f6ffed; }
.overview-card.pending { background: #fff7e6; }
.overview-card.rate { background: #fff0f6; }
.overview-num { font-size: 44rpx; font-weight: bold; }
.overview-card.total .overview-num { color: #1890ff; }
.overview-card.done .overview-num { color: #52c41a; }
.overview-card.pending .overview-num { color: #fa8c16; }
.overview-card.rate .overview-num { color: #eb2f96; }
.overview-label { font-size: 24rpx; color: #666; }

.progress-bar-wrap { margin-bottom: 20rpx; }
.progress-bar-bg { height: 14rpx; background: #f0f0f0; border-radius: 7rpx; overflow: hidden; }
.progress-bar-fill { height: 100%; background: linear-gradient(90deg,#F03038,#ED1C24); border-radius: 7rpx; transition: width 0.4s ease; }

.batch-remind { }
.remind-all-btn {
  width: 100%; height: 80rpx; line-height: 80rpx;
  background: linear-gradient(135deg,#ff4d4f,#ff7875);
  color: #fff; font-size: 28rpx; font-weight: bold;
  border-radius: 14rpx; border: none; padding: 0;
}

/* ========== 党员列表 ========== */
.student-section { margin-bottom: 24rpx; }
.section-title-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 30rpx; border-radius: 16rpx 16rpx 0 0;
}
.section-title-bar.done { background: #f6ffed; }
.section-title-bar.pending { background: #fff7e6; }
.section-title-text { font-size: 28rpx; font-weight: bold; }
.section-title-bar.done .section-title-text { color: #52c41a; }
.section-title-bar.pending .section-title-text { color: #fa8c16; }
.section-count { font-size: 24rpx; color: #999; }

.student-cards {
  background: rgba(255,255,255,0.95);
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(237,28,36,0.06);
}
.student-card {
  display: flex; align-items: center; padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.student-card:last-child { border-bottom: none; }
.student-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx; font-weight: bold;
  margin-right: 20rpx; flex-shrink: 0;
}
.student-avatar.done-avatar { background: linear-gradient(135deg,#52c41a,#389e0d); }
.student-avatar.pending-avatar { background: linear-gradient(135deg,#fa8c16,#d46b08); }
.student-detail { flex: 1; min-width: 0; }
.s-name { font-size: 28rpx; font-weight: bold; color: #333; display: block; }
.s-school { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }

.student-score-box {
  padding: 8rpx 20rpx; border-radius: 20rpx; margin-left: 12rpx;
}
.student-score-box.excellent { background: #f6ffed; }
.student-score-box.pass { background: #fffbe6; }
.student-score-box.fail { background: #fff2f0; }
.score-text { font-size: 24rpx; font-weight: bold; }
.student-score-box.excellent .score-text { color: #52c41a; }
.student-score-box.pass .score-text { color: #fa8c16; }
.student-score-box.fail .score-text { color: #ff4d4f; }

/* 催促按钮 */
.remind-btn {
  height: 60rpx; line-height: 60rpx; padding: 0 24rpx;
  font-size: 24rpx; border-radius: 30rpx; border: none;
  background: #fff2f0; color: #ff4d4f;
  flex-shrink: 0; margin-left: 12rpx;
}
.remind-btn.reminded {
  background: #f5f5f5; color: #bbb;
}

/* ========== 空状态 ========== */
.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 100rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }
