@import '../../styles/iconfont.wxss';

page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 导航栏样式 */
.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 0rpx;
}

.title-sub {
  font-size: 30rpx;
  color: #FFF;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.score-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.score-label-vertical {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.score-label-vertical text {
  font-size: 22rpx;
  color: #FFD700;
  font-weight: 500;
  line-height: 1;
}

.score-value {
  font-size: 40rpx;
  color: #FFD700;
  font-weight: bold;
  font-family: "Arial", sans-serif;
}

.divider {
  width: 2rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 1rpx;
}

.logo-flip-container {
  width: 80rpx;
  height: 80rpx;
  perspective: 1000rpx;
}

.logo-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
}

.flip-animation {
  animation: logoFlip 4s ease-in-out infinite;
}

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front,
.logo-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-front {
  background: #FFF;
  border-radius: 50%;
  overflow: hidden;
}

.logo-image {
  width: 90%;
  height: 90%;
}

.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg);
  flex-direction: column;
  border: 2rpx solid #FFF;
  justify-content: center;
  align-items: center;
}

.school-name {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  white-space: nowrap;
}

.school-name-university {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 18rpx;
  color: #FFF;
  font-weight: bold;
  margin-top: 2rpx;
}

.container {
  position: relative;
  z-index: 1;
  padding: 20rpx;
  background: rgba(245, 245, 245, 0.9);
  min-height: 100vh;
  padding-top: 160rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #ED1C24;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 30rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.tip-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.login-btn {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
}

.tab-nav {
  display: flex;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ED1C24;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #ED1C24;
  border-radius: 2rpx;
}

.stats-card {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stats-header {
  margin-bottom: 30rpx;
}

.stats-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  display: block;
}

.stats-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
  display: block;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-card {
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.stat-icon {
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto 10rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 50%;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
  display: block;
}

.section-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #ED1C24;
}

.radar-container {
  display: flex;
  flex-direction: column;
}

.radar-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.radar-label {
  width: 120rpx;
  font-size: 24rpx;
  color: #666;
}

.radar-bar {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.radar-fill {
  height: 100%;
  background: linear-gradient(90deg, #F03038 0%, #ED1C24 100%);
  transition: width 0.3s;
}

.radar-value {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: #ED1C24;
  font-weight: bold;
}

.weekly-stats {
  display: flex;
  flex-direction: column;
}

.day-stat {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.day-stat:last-child {
  border-bottom: none;
}

.day-date {
  font-size: 26rpx;
  color: #666;
}

.day-duration {
  font-size: 26rpx;
  color: #ED1C24;
  font-weight: bold;
}

.empty-stats, .empty-records {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.action-btn {
  background: rgba(248, 248, 248, 0.95);
  border-radius: 12rpx;
  padding: 30rpx;
  text-align: center;
}

.action-btn.disabled {
  opacity: 0.6;
}

.action-icon {
  width: 60rpx;
  height: 60rpx;
  background: #ED1C24;
  border-radius: 50%;
  margin: 0 auto 16rpx;
}

.action-text {
  font-size: 26rpx;
  color: #333;
}

.records-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.course-icon {
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
}

.assignment-icon {
    background: linear-gradient(135deg, #4CAF50 0%, #45A049 100%);
}

.exam-icon {
    background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
}


.record-icon-text {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.record-info {
  flex: 1;
}

.record-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.record-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
}

.record-date {
  font-size: 20rpx;
  color: #ccc;
  display: block;
}

.record-progress {
  width: 60rpx;
}

.progress-mini {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-mini-fill {
  height: 100%;
  background: linear-gradient(90deg, #F03038 0%, #ED1C24 100%);
}

.checkin-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.checkin-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.checkin-subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.checkin-status {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.checkin-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-btn.checked {
  background: linear-gradient(135deg, #999, #ccc);
}

.checkin-btn-inner {
  text-align: center;
  color: white;
}

.checkin-icon {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 50%;
  margin: 0 auto 16rpx;
}

.checkin-text {
  font-size: 32rpx;
  font-weight: bold;
}

.checkin-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.checkin-stat-item {
  text-align: center;
  background: rgba(248, 248, 248, 0.95);
  padding: 30rpx;
  border-radius: 12rpx;
}

.checkin-stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ED1C24;
  display: block;
}

.checkin-stat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
  display: block;
}
