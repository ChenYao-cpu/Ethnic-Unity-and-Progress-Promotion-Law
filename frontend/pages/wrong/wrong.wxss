@import '../../styles/iconfont.wxss';

page {
  background: #F5F5F5;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.nav-header {
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
  width: 100%;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 0 30rpx;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-left { display: flex; align-items: center; z-index: 101; }

.nav-back {
  width: 80rpx; height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; z-index: 101;
}

.back-hover { background: rgba(255,255,255,0.2); border-radius: 50%; }

.back-icon { font-size: 48rpx; color: #FFF; font-weight: bold; line-height: 1; }

.nav-title { display: flex; align-items: baseline; gap: 8rpx; }

.title-main {
  font-family: "MaoFont", "STXingkai", "KaiTi", serif;
  font-size: 60rpx; color: #FFF; font-weight: bold;
}

.title-sub { font-size: 30rpx; color: #FFF; font-weight: bold; letter-spacing: 4rpx; }

.nav-right { display: flex; align-items: center; gap: 20rpx; }

.score-display { display: flex; align-items: center; gap: 12rpx; }

.score-label-vertical { display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.score-label-vertical text { font-size: 22rpx; color: #FFD700; font-weight: 500; line-height: 1; }

.score-value { font-size: 40rpx; color: #FFD700; font-weight: bold; font-family: "Arial", sans-serif; }

.divider { width: 2rpx; height: 36rpx; background: rgba(255,255,255,0.5); border-radius: 1rpx; }

.logo-flip-container { width: 80rpx; height: 80rpx; perspective: 1000rpx; }
.logo-card { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; }
.flip-animation { animation: logoFlip 4s ease-in-out infinite; }

@keyframes logoFlip {
  0%, 40% { transform: rotateY(0deg); }
  50%, 90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}

.logo-front, .logo-back {
  position: absolute; width: 100%; height: 100%;
  backface-visibility: hidden; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.logo-front { background: #FFF; border-radius: 50%; overflow: hidden; }
.logo-image { width: 90%; height: 90%; }
.logo-back {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  transform: rotateY(180deg); flex-direction: column;
  border: 2rpx solid #FFF; justify-content: center; align-items: center;
}
.school-name { font-family: "MaoFont", "STXingkai", "KaiTi", serif; font-size: 18rpx; color: #FFF; font-weight: bold; white-space: nowrap; }
.school-name-university { font-family: "MaoFont", "STXingkai", "KaiTi", serif; font-size: 18rpx; color: #FFF; font-weight: bold; margin-top: 2rpx; }

/* ========== 内容区 ========== */
.content-wrapper {
  position: relative; z-index: 1;
  padding-top: 160rpx;
  padding-bottom: 40rpx;
}

/* 空状态 */
.empty-page {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding-top: 200rpx;
}
.empty-icon { font-size: 120rpx; color: #F03038; margin-bottom: 30rpx; }
.empty-text { font-size: 28rpx; color: #666; }

/* ========== 开始页 ========== */
.start-wrapper {
  padding: 30rpx;
  display: flex; flex-direction: column; align-items: center; gap: 30rpx;
}

.wrong-count-card {
  background: linear-gradient(135deg, #F03038, #ED1C24);
  border-radius: 24rpx; padding: 50rpx 60rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(237,28,36,0.25);
}
.count-num { font-size: 100rpx; color: #FFF; font-weight: bold; line-height: 1; }
.count-label { font-size: 28rpx; color: rgba(255,255,255,0.85); margin-top: 12rpx; }

.wrong-preview-list {
  width: 100%;
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx; padding: 20rpx;
  max-height: 500rpx; overflow-y: auto;
}
.preview-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 16rpx; border-bottom: 1rpx solid #f0f0f0;
}
.preview-q { font-size: 26rpx; color: #333; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.preview-type { font-size: 22rpx; color: #F03038; margin-left: 16rpx; flex-shrink: 0; }

.btn-start {
  width: 100%; height: 90rpx; line-height: 90rpx;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF; border-radius: 45rpx; font-size: 32rpx; font-weight: bold;
  border: none; box-shadow: 0 8rpx 24rpx rgba(237,28,36,0.3);
}

/* ========== 答题中 ========== */
.practice-page { padding: 0 30rpx; }

.practice-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20rpx;
}
.remain-badge {
  background: rgba(255,255,255,0.95); padding: 10rpx 24rpx;
  border-radius: 20rpx; font-size: 26rpx; color: #333; font-weight: bold;
}
.score-change {
  font-size: 28rpx; color: #4CAF50; font-weight: bold;
}

.question-card {
  background: rgba(255,255,255,0.95); border-radius: 20rpx;
  padding: 30rpx; box-shadow: 0 8rpx 24rpx rgba(237,28,36,0.08);
  margin-bottom: 20rpx;
}

.q-type-tag {
  display: inline-block;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF; padding: 6rpx 20rpx; border-radius: 8rpx;
  font-size: 22rpx; margin-bottom: 20rpx;
}

.q-text {
  font-size: 32rpx; color: #2d3748; line-height: 1.7;
  margin-bottom: 30rpx; font-weight: 500; display: block;
}

/* 选项 */
.options-list { display: flex; flex-direction: column; gap: 14rpx; }

.opt-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 24rpx; background: rgba(237,28,36,0.04);
  border-radius: 14rpx; border: 2rpx solid transparent;
  transition: all 0.2s;
}

.opt-label {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: rgba(237,28,36,0.08); color: #ED1C24;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: bold; flex-shrink: 0;
}

.opt-text { font-size: 28rpx; color: #333; }

.opt-item.opt-active {
  border-color: #ED1C24; background: rgba(237,28,36,0.08);
}
.opt-item.opt-active .opt-label { background: #ED1C24; color: #FFF; }

.opt-item.opt-correct {
  border-color: #4CAF50; background: rgba(76,175,80,0.1);
}
.opt-item.opt-correct .opt-label { background: #4CAF50; color: #FFF; }

.opt-item.opt-wrong {
  border-color: #F03038; background: rgba(240,48,56,0.08);
}
.opt-item.opt-wrong .opt-label { background: #F03038; color: #FFF; }

/* 结果区 */
.result-box {
  margin-top: 24rpx; padding-top: 24rpx;
  border-top: 2rpx solid #eee;
}

.result-header {
  padding: 16rpx 20rpx; border-radius: 12rpx;
  font-size: 26rpx; font-weight: bold; text-align: center; margin-bottom: 14rpx;
}
.result-correct { background: rgba(76,175,80,0.1); color: #388E3C; }
.result-wrong { background: rgba(240,48,56,0.1); color: #D32F2F; }

.result-answer {
  font-size: 26rpx; color: #4CAF50; font-weight: bold; display: block; margin-bottom: 10rpx;
}
.result-analysis {
  font-size: 26rpx; color: #718096; line-height: 1.6; display: block;
}

.practice-footer { padding-top: 20rpx; }

.btn-next {
  width: 100%; height: 80rpx; line-height: 80rpx;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF; border-radius: 40rpx; font-size: 30rpx; font-weight: bold;
  border: none; box-shadow: 0 4rpx 12rpx rgba(237,28,36,0.3);
}

/* ========== 完成页 ========== */
.done-page {
  padding: 30rpx; display: flex; flex-direction: column; align-items: center; gap: 40rpx;
}

.done-card {
  background: rgba(255,255,255,0.95); border-radius: 24rpx;
  padding: 60rpx 40rpx; text-align: center; width: 100%;
  box-shadow: 0 8rpx 24rpx rgba(237,28,36,0.08);
}

.done-icon { font-size: 100rpx; display: block; margin-bottom: 20rpx; }
.done-title { font-size: 36rpx; color: #333; font-weight: bold; display: block; margin-bottom: 30rpx; }

.done-stats { display: flex; justify-content: center; gap: 80rpx; }
.done-stat { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.done-num { font-size: 60rpx; font-weight: bold; }
.done-num.green { color: #4CAF50; }
.done-num.red { color: #F03038; }
.done-label { font-size: 24rpx; color: #999; }

.btn-back {
  width: 100%; height: 90rpx; line-height: 90rpx;
  background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
  color: #FFF; border-radius: 45rpx; font-size: 32rpx; font-weight: bold;
  border: none; box-shadow: 0 8rpx 24rpx rgba(237,28,36,0.3);
}
